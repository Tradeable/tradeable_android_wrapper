<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TradeableSDK" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Opaque window: translucent windows break SurfaceView/WebView video
             compositing (audio plays, video surface stays blank). -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    
    <style name="Theme.TradeableSDK.FullScreen" parent="Theme.TradeableSDK">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
